name: Build Android App

on:
  push:
    branches: [ main, master ]
  pull_request:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    - name: Setup Android SDK
      uses: android-actions/setup-android@v3

    - name: Install NDK & Build Tools
      run: |
        sdkmanager --install "ndk;25.2.9519653" "cmake;3.22.1"

    - name: Make Gradle executable
      run: chmod +x ./gradlew

    - name: Build with Gradle
      run: ./gradlew assembleRelease

    - name: Pack Magisk Module Zip
      run: |
        mkdir -p output_zip
        mkdir -p magisk_pkg/system/lib64
        
        # Copy compiled binaries from build outputs to the module system folder
        find . -name "*.so" -exec cp {} magisk_pkg/system/lib64/ \;
        
        # Copy module configuration files if they exist, or create standard props
        if [ -d "module" ]; then
          cp -r module/* magisk_pkg/ 2>/dev/null || true
        fi
        
        if [ ! -f "magisk_pkg/module.prop" ]; then
          echo "id=reveny_zygisk" > magisk_pkg/module.prop
          echo "name=Reveny Zygisk Mod" >> magisk_pkg/module.prop
          echo "version=v1.0" >> magisk_pkg/module.prop
          echo "versionCode=1" >> magisk_pkg/module.prop
          echo "author=Reveny" >> magisk_pkg/module.prop
          echo "description=Zygisk module built automatically via GitHub Actions" >> magisk_pkg/module.prop
        fi
        
        # Create final flashable zip
        cd magisk_pkg && zip -r ../output_zip/Reveny_Zygisk_Flashable.zip .

    - name: Upload Module Artifact
      uses: actions/upload-artifact@v4
      with:
        name: Magisk-Module-Zip
        path: output_zip/*.zip
